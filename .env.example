# Environment Variables for UniChat Messenger

# Node Environment
NODE_ENV=development

# Database Configuration
DB_USER=unichat
DB_PASSWORD=secure_password_123
DB_NAME=unichat_db
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql://unichat:secure_password_123@postgres:5432/unichat_db

# Redis Configuration
REDIS_PASSWORD=redis_secure_123
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://:redis_secure_123@redis:6379

# JWT & Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars
JWT_EXPIRY=3600
REFRESH_TOKEN_SECRET=your_refresh_secret_change_in_production_min_32_chars
REFRESH_TOKEN_EXPIRY=604800

# SMS & OTP (placeholder - implement with Twilio or similar)
SMS_PROVIDER=mock
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=UniChat

# File Upload
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=52428800
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm,audio/mpeg,audio/ogg,application/pdf

# Server Configuration
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Email Configuration (optional for future)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
BCRYPT_ROUNDS=10

# Frontend Configuration
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3000
